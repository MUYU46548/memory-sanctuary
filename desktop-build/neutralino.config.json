{
  "applicationId": "io.ronghua.memorysanctuary",
  "version": "0.2.12",
  "applicationName": "记忆圣所",
  "author": "暮雨",
  "copyright": "© 2026 暮雨",
  "description": "记忆圣所 · 末日叙事驱动的记忆留存游戏",
  "applicationIcon": "../assets/icons/icon-256.png",
  "defaultMode": "window",
  "url": "/resources/index.html",
  "enableServer": true,
  "enableNativeAPI": true,
  "nativeAllowList": [
    "app.exit"
  ],
  "nativeDependency": false,
  "tokenSecurity": "none",
  "modes": {
    "window": {
      "title": "记忆圣所 · Memory Sanctuary",
      "width": 1400,
      "height": 900,
      "minWidth": 1200,
      "minHeight": 750,
      "center": true,
      "resizable": true,
      "maximize": true,
      "fullscreen": false,
      "enableInspector": false,
      "borderless": false
    }
  },
  "cli": {
    "binaryName": "MemorySanctuary",
    "clientLibrary": "resources/neutralino.js",
    "resourcesPath": "resources",
    "extensionsPath": "extensions",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0",
    "distributionPath": "dist"
  }
}
