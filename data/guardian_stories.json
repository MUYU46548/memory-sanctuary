{
  "guardian_stories": [
    {
      "id": "tika_story_1",
      "guardianId": "tika",
      "title": "失落的歌谣",
      "trigger": {
        "type": "mood_check",
        "moodTier": "friendly",
        "weekMin": 6,
        "probability": 0.2
      },
      "description": "缇卡在归档一段关于古老歌谣的条目后，突然唱起了旋律。那是她母亲教她的歌——关于一个失落的季节。",
      "choices": [
        {
          "text": "静静地听她唱完",
          "effect": {
            "tikaMood": 3
          },
          "result": "缇卡的眼中闪烁着泪光。'谢谢你……这是我第一次在别人面前唱这首歌。'"
        },
        {
          "text": "建议她教给你",
          "effect": {
            "tikaMood": 2,
            "energy": -5
          },
          "result": "缇卡微笑着点头。'好，跟我唱。'你笨拙地跟着哼唱，她笑得眼角都弯了。"
        }
      ]
    },
    {
      "id": "tika_story_2",
      "guardianId": "tika",
      "title": "最后的演出",
      "trigger": {
        "type": "week",
        "week": 18,
        "probability": 0.3
      },
      "description": "缇卡站在主厅中央，闭上眼睛。'我想再唱一次。不是为了记录，只是为了……唱。'",
      "choices": [
        {
          "text": "为她伴奏（消耗 5 能源）",
          "effect": {
            "tikaMood": 4,
            "energy": -5
          },
          "result": "你的掌声是她听过最好的伴奏。她深深鞠了一躬，像个真正的歌者。"
        },
        {
          "text": "安静地聆听",
          "effect": {
            "tikaMood": 2
          },
          "result": "歌声在穹顶下回荡。没有观众，没有掌声，但这一刻比任何演出都珍贵。"
        }
      ]
    },
    {
      "id": "tika_story_3",
      "guardianId": "tika",
      "title": "给后世的信",
      "trigger": {
        "type": "week",
        "week": 35,
        "probability": 0.4
      },
      "description": "缇卡拿着一封手写信。'这是给找到圣所的人的。你觉得……他们会听懂我们的歌吗？'",
      "choices": [
        {
          "text": "告诉他们会的",
          "effect": {
            "tikaMood": 3
          },
          "result": "缇卡微笑着把信折好，放进存储室。'谢谢你。这让我觉得……一切都值得。'"
        },
        {
          "text": "沉默地握住她的手",
          "effect": {
            "tikaMood": 2
          },
          "result": "缇卡没有说话，但她的手微微收紧了。"
        }
      ]
    },
    {
      "id": "finn_story_1",
      "guardianId": "finn",
      "title": "未完之页",
      "trigger": {
        "type": "week",
        "week": 12,
        "probability": 0.3
      },
      "description": "芬恩在整理旧文档时，发现了一页未完成的编年史——那是关于他自己的故事，只写了一半。",
      "choices": [
        {
          "text": "帮他写完这一页",
          "effect": {
            "finnMood": 3,
            "energy": -10
          },
          "result": "芬恩认真地说：'你怎么知道我心里想的什么？'他接过笔，和你一起写完了那一页。"
        },
        {
          "text": "告诉他真相",
          "effect": {
            "finnMood": -2,
            "environment": -5
          },
          "result": "芬恩叹了口气：'我知道。但我一直在逃避。'"
        }
      ]
    },
    {
      "id": "finn_story_2",
      "guardianId": "finn",
      "title": "编年史官的困惑",
      "trigger": {
        "type": "mood_check",
        "moodTier": "friendly",
        "weekMin": 15,
        "probability": 0.25
      },
      "description": "芬恩停下笔，看着你。'我在写你的故事。但我不确定……该怎么写结局。'",
      "choices": [
        {
          "text": "让结局自己书写",
          "effect": {
            "finnMood": 3
          },
          "result": "芬恩点点头，继续书写。'你说得对。最好的编年史不需要结局。'"
        },
        {
          "text": "写一个希望的结局",
          "effect": {
            "finnMood": 2,
            "energy": -5
          },
          "result": "芬恩的笔在纸上飞舞。'希望……是的，我们应该留下希望。'"
        }
      ]
    },
    {
      "id": "finn_story_3",
      "guardianId": "finn",
      "title": "历史的重量",
      "trigger": {
        "type": "week",
        "week": 40,
        "probability": 0.35
      },
      "description": "芬恩看着满存储室的文档。'我们保存了这么多……但谁来读呢？'",
